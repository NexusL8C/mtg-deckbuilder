# ==============================================================================
# ArcaneForge MTG Deckbuilder Environment Variables
# ==============================================================================

# PostgreSQL connection string from Neon (https://neon.tech)
# 1. Sign up / log in with GitHub at https://neon.tech
# 2. Click "Create Project" (e.g., name it "mtg-deckbuilder")
# 3. Copy the Connection String from your dashboard and paste it here:
DATABASE_URL=postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-YOUR-ENDPOINT-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Port for the Node.js API (Default 3001 aligns with Vite's dev proxy)
PORT=3001

# Frontend URL
FRONTEND_URL=http://localhost:5173
