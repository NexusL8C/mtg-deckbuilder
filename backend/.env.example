# ==============================================================================
# ArcaneForge Backend Environment Variables
# ==============================================================================

# PostgreSQL connection string from Neon (https://neon.tech)
# 1. Sign up / log in with GitHub at neon.tech
# 2. Create a project named "mtg-deckbuilder"
# 3. Copy the connection string and paste it below:
DATABASE_URL=postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-YOUR-ENDPOINT-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Port to listen on (Default 3001 matches Vite's dev proxy)
PORT=3001

# Frontend URL
FRONTEND_URL=http://localhost:5173
